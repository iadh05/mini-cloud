  },
  "dependencies": {
    "@mini-cloud/shared": "*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  }
}
