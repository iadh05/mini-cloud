{
  "name": "mini-cloud",
  "private": true,
  "type": "module",
  "description": "A small self-hosted cloud: API, provisioner worker and console",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p . && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run lint:deps && npm run lint:claude && npm run typecheck && npm run test:coverage",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "prepare": "husky",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "lint:claude": "node scripts/check-claude-md.js",
    "db:generate": "npm run generate -w @mini-cloud/db",
    "db:migrate": "npm run migrate -w @mini-cloud/db",
    "test:coverage": "vitest run --coverage",
    "api:dev": "npm run dev -w @mini-cloud/api"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
